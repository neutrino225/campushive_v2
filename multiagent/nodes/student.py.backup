    if route == "timetable":
        try:
            agent = _get_timetable_agent()
            final_answer = ""
            config_dict = {"configurable": {"thread_id": "student_timetable_streaming"}}
            for step in agent.stream(
                {"messages": [HumanMessage(content=question)]},
                config_dict,
                stream_mode="values",
