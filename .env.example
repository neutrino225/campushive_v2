# Environment variables for CampusHive
# Copy this file to `.env` and fill in the values.

# --- API Keys ---
# Required: Groq API key for ChatGroq LLM
GROQ_API_KEY=your_groq_api_key_here
# Optional: OpenAI key (can be used instead of Groq)
OPENAI_API_KEY=your_openai_api_key_here

# Optional provider controls:
# LLM_PROVIDER=auto|groq|openai
# EMBEDDING_PROVIDER=auto|ollama|openai
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_SMALL_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- ChromaDB Configuration ---
# Set to False to disable telemetry and prevent posthog errors
# This fixes: "Failed to send telemetry event ClientStartEvent: capture() takes 1 positional argument but 3 were given"
ANONYMIZED_TELEMETRY=False
